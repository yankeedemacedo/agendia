extends layout

block content
  .nav-back
    a(href="/") 
      i.fas.fa-chevron-left
      |   VOLTAR AO PAINEL

  .main-admin-container(style="max-width: 1200px; margin: 0 auto; padding: 40px 20px;")
    
    // Cabeçalho da Tela
    .admin-header(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; flex-wrap: wrap; gap: 20px;")
      div
        h1(style="font-size: 2rem; margin-bottom: 5px;") Gerenciar Eventos
        p(style="color: var(--text-muted, #aaa); margin: 0;") Administre os eventos publicados na plataforma Agendia
      a.btn-play(href="/admin/events/criar-evento" style="padding: 12px 24px; text-decoration: none; font-size: 0.9rem; display: flex; align-items: center; gap: 8px;")
        i.fas.fa-plus
        | Novo Evento

    // Containers de Feedback Globais
    #global-error(style="display: none; background-color: #ff4d4d22; color: #ff4d4d; padding: 12px; border-radius: 6px; margin-bottom: 20px; text-align: center; border: 1px solid #ff4d4d44;")
    #global-success(style="display: none; background-color: #10b98122; color: #10b981; padding: 12px; border-radius: 6px; margin-bottom: 20px; text-align: center; border: 1px solid #10b98144;")

    // Grid de Eventos
    if events && events.length > 0
      .events-grid(style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 25px;")
        each event in events
          // Adicionado data-event-id e posicionamento relativo isolado
          .event-card(style="background: #1e1e1e; border: 1px solid #333; border-radius: 8px; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; position: relative; z-index: 1;" data-event-id=event.id)
            
            // Corpo do Card
            .event-card-body(style="flex: 1; min-width: 0;")
              .event-badge(style="display: inline-block; padding: 4px 8px; background: #2a2a2a; border-radius: 4px; font-size: 0.75rem; color: var(--text-muted, #aaa); margin-bottom: 12px;") #{event.acesso}
              h3(style="font-size: 1.25rem; margin: 0 0 10px 0; color: #fff;") #{event.titulo}
              p(style="color: #aaa; font-size: 0.9rem; line-height: 1.5; margin-bottom: 20px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;") #{event.descricao}
              
              // Detalhes (Data, Hora, Local, Vagas)
              .event-details(style="display: flex; flex-direction: column; gap: 8px; font-size: 0.85rem; color: #888; margin-bottom: 20px;")
                div(style="display: flex; align-items: center; gap: 8px;")
                  i.fas.fa-calendar-alt(style="width: 16px; color: var(--primary, #3b82f6);")
                  span #{event.data} às #{event.horario}
                div(style="display: flex; align-items: center; gap: 8px;")
                  i.fas.fa-map-marker-alt(style="width: 16px; color: var(--primary, #3b82f6);")
                  span #{event.local}
                div(style="display: flex; align-items: center; gap: 8px;")
                  i.fas.fa-users(style="width: 16px; color: var(--primary, #3b82f6);")
                  span #{event.vagas} vagas no total

            // Container de ações ISOLADO com z-index alto e pointer-events livre
            .event-card-actions(style="display: flex; gap: 10px; border-top: 1px solid #333; padding-top: 15px; margin-top: auto; position: relative; z-index: 10; pointer-events: auto;")
              
              // Botão Editar (Link direto z-index isolado)
              a.btn-edit(href=`/admin/editar-evento/${event.id}` style="flex: 1; padding: 10px; text-align: center; background: #2a2a2a; color: #fff; border: 1px solid #444; border-radius: 4px; font-size: 0.85rem; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 6px; font-weight: 500;")
                i.fas.fa-edit
                | Editar
              
              // Botão Deletar passando 'this'
              button.btn-delete(type="button" onclick="deleteEvent(this)" style="flex: 1; padding: 10px; background: #ff4d4d22; color: #ff4d4d; border: 1px solid #ff4d4d44; border-radius: 4px; font-size: 0.85rem; cursor: pointer !important; display: flex; align-items: center; justify-content: center; gap: 6px; font-weight: 500;")
                i.fas.fa-trash-alt(style="pointer-events: none;")
                | Deletar
    else
      // Estado Vazio (Sem eventos)
      .empty-state(style="text-align: center; padding: 60px 20px; background: #1e1e1e; border: 1px solid #333; border-radius: 8px;")
        i.fas.fa-calendar-times(style="font-size: 4rem; color: #444; margin-bottom: 20px;")
        h3 Nenhum evento encontrado
        p(style="color: var(--text-muted, #aaa); margin-bottom: 20px;") Você ainda não publicou nenhum evento na plataforma.
        a.btn-play(href="/admin/events/criar-evento" style="padding: 10px 20px; font-size: 0.85rem;") Criar Primeiro Evento

  // Estilos limpos focados exclusivamente nas interações de Hover, sem quebrar o Grid
  style.
    .btn-edit:hover {
      background: #3a3a3a !important;
      border-color: #555 !important;
    }
    .btn-delete:hover {
      background: #ff4d4d !important;
      color: #fff !important;
      box-shadow: 0 4px 12px rgba(255, 77, 77, 0.3);
    }
    .btn-delete:disabled {
      opacity: 0.5 !important;
      cursor: not-allowed !important;
    }

  // Script com a mesma arquitetura encapsulada e segura
  script.
    async function deleteEvent(button) {
      if (!confirm("Tem certeza que deseja excluir permanentemente este evento?")) return;

      const card = button.closest('.event-card');
      const eventId = card.getAttribute('data-event-id');
      const errorBox = document.getElementById('global-error');
      const successBox = document.getElementById('global-success');
      const originalText = button.innerHTML;
      
      errorBox.style.display = 'none';
      successBox.style.display = 'none';

      try {
        button.innerText = "Excluindo...";
        button.disabled = true;

        const response = await fetch(`/api/events/${eventId}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json'
          }
        });

        if (response.ok) {
          successBox.innerText = 'Evento removido com sucesso!';
          successBox.style.display = 'block';
          window.scrollTo({ top: 0, behavior: 'smooth' });

          // Animação idêntica de Fade e Scale Out
          card.style.opacity = '0';
          card.style.transform = 'scale(0.95)';
          card.style.transition = 'all 0.3s ease';
          
          setTimeout(() => {
            card.remove();
            if (document.querySelectorAll('.event-card').length === 0) {
              window.location.reload();
            }
          }, 300);
        } else {
          const data = await response.json();
          errorBox.innerText = data.error || data.message || 'Erro ao tentar deletar o evento.';
          errorBox.style.display = 'block';
          window.scrollTo({ top: 0, behavior: 'smooth' });
          button.innerHTML = originalText;
          button.disabled = false;
        }
      } catch (err) {
        console.error(err);
        errorBox.innerText = 'Erro de conexão com o servidor ao tentar deletar.';
        errorBox.style.display = 'block';
        window.scrollTo({ top: 0, behavior: 'smooth' });
        button.innerHTML = originalText;
        button.disabled = false;
      }
    }