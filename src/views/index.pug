extends layout

block content
  section
      header.section-header(style="display: flex; justify-content: space-between; align-items: center; height: 100px; gap-wrap: wrap; gap: 10px; margin-bottom: 40px;")
        div
          h2(style="margin: 0;") Catálogo de Eventos
          p(style="color: var(--text-gray); margin: 0;") Explore experiências exclusivas em Natal
        
        .search-container
          form#searchForm(style="display: flex; gap: 10px; width: 400px;")
            .field(style="flex: 1; position: relative;")
              i.fas.fa-search(style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #666;")
              input#searchInput(
                type="text" 
                placeholder="Buscar por nome..." 
                style="padding-left: 45px; width: 100%; border: 1px solid #333; background: #222; color: white; height: 45px; border-radius: 8px; outline: none;"
                value=searchTerm
              )
            button.btn-play(type="submit" style="width: auto; padding: 0 20px; height: 45px; font-size: 0.8rem;") BUSCAR

      .event-grid
        each event in events
          a.event-card(href=`/events/${event.id}`)
            - const statusClass = (event.acesso || 'Público').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
            span(class=`status-badge ${statusClass}`)
              i.fas.fa-circle
              | #{event.acesso || 'Público'}
            
            .event-content
              h3 #{event.title || event.titulo}
              
              .event-info-row
                i.far.fa-calendar-alt
                span #{event.date || event.data}
                
              .event-info-row
                i.fas.fa-map-marker-alt
                span #{event.local || 'Natal, RN'}
        else
          .empty-state(style="text-align: center; padding: 50px;")
            i.fas.fa-calendar-times(style="font-size: 3rem; color: #333; margin-bottom: 20px;")
            p Nenhum evento encontrado com esse nome.

  //- Script para transformar o input em rota amigável /nome
  script.
    document.getElementById('searchForm').addEventListener('submit', function(e) {
      e.preventDefault();
      const query = document.getElementById('searchInput').value.trim();
      
      if (query) {
        // Redireciona para /event/NomeDoEvento
        window.location.href = '/event/' + encodeURIComponent(query);
      } else {
        // Se vazio, volta para a home
        window.location.href = '/';
      }
    });