# Copie para .env e preencha (nunca commite o .env)
MONGO_URI="mongodb+srv://<usuario>:<senha>@<cluster>/?appName=Agendia"
PORT="3000"
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
NODE_ENV="development"

# E-mail (Fase 2: lembretes e promoção da waitlist). Sem isso, o envio é ignorado com aviso.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="agendia! <noreply@agendia.com>"

# Deploy com front em domínio próprio (Vercel etc.): origens separadas por vírgula.
# Habilita CORS + cookie SameSite=None. Local (proxy do Vite), deixe vazio.
FRONTEND_URL="https://agendia-web-pi.vercel.app"
# Opcional: força o SameSite do cookie (strict|lax|none). Default: none se FRONTEND_URL, senão strict.
# COOKIE_SAMESITE="none"
